



<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>صفحتي المتقدمة</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      direction: rtl;
      background: linear-gradient(120deg, #74ebd5, #9face6);
    }

    .navbar {
      background-color: #2c3e50;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }

    .navbar h2 {
      margin: 0;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
      transition: color 0.3s;
    }

    .nav-links a:hover {
      color: #74ebd5;
    }

    .card {
      background-color: white;
      margin: 80px auto;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      text-align: center;
      width: 350px;
    }

    h1 {
      color: #2c3e50;
      margin-bottom: 10px;
    }

    p {
      color: #555;
      margin-bottom: 20px;
    }

    a.button {
      display: inline-block;
      background-color: #3498db;
      color: white;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 8px;
      transition: background-color 0.3s;
    }

    a.button:hover {
      background-color: #2980b9;
    }
  </style>
</head>
<body>
  <!-- الشريط العلوي -->
  <div class="navbar">
    <h2>موقعي</h2>
    <div class="nav-links">
      <a href="#">الرئيسية</a>
      <a href="#">عنّي</a>
      <a href="#">تواصل</a>
    </div>
  </div>

  <!-- المحتوى الرئيسي -->
  <div class="card">
    <h1>مرحبًا بك!</h1>
    <p>صفحة متقدمة بتصميم أنيق وقائمة تنقل</p>
